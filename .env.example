# Copy to .env (git-ignored) and edit. The API loads it on startup.
FRR_SSH_USERNAME=admin
# Required: device tools return an error until this is set.
# The lab image uses admin/admin; use a real secret for anything else.
FRR_SSH_PASSWORD=admin
FRR_SSH_TIMEOUT=8
# Port used when connecting without an inventory port (rarely needed)
FRR_SSH_PORT=22
# 1 = only trust hosts already in ~/.ssh/known_hosts (use for real devices)
FRR_SSH_STRICT_HOST_KEYS=0

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Analyzer (/analyze). Default provider is a local Ollama; set these to change it.
# BGP_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# BGP_LLM_URL=http://localhost:11434
